<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.finanzas.controller.CategoriasController">
    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn text="Nombre" fx:id="colNombre" prefWidth="250"/>
                <TableColumn text="Tipo" fx:id="colTipo" prefWidth="120"/>
            </columns>
        </TableView>
    </center>
    <left>
        <VBox spacing="8" alignment="TOP_CENTER" prefWidth="230">
            <padding>
                <Insets topRightBottomLeft="10"/>
            </padding>
            <Label fx:id="lblForm" text="Nueva categoría" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtNombre" promptText="Nombre"/>
            <ComboBox fx:id="cmbTipo" prefWidth="210"/>
            <HBox spacing="8" alignment="CENTER">
                <Button fx:id="btnSave" text="Guardar" onAction="#onSave" style="-fx-min-width: 90px;"/>
                <Button text="Nuevo" onAction="#onNew" style="-fx-min-width: 90px;"/>
            </HBox>
            <Button fx:id="btnDelete" text="Eliminar seleccionada" onAction="#onDelete" style="-fx-min-width: 190px;"/>
        </VBox>
    </left>
</BorderPane>
