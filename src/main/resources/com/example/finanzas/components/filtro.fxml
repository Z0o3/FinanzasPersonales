<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<FlowPane xmlns:fx="http://javafx.com/fxml" hgap="12" vgap="8"
          fx:controller="com.example.finanzas.controller.FiltroController">
    <padding>
        <Insets topRightBottomLeft="8"/>
    </padding>
    <VBox spacing="2">
        <Label text="Buscar"/>
        <TextField fx:id="txtTexto" promptText="Concepto, categoría, etiqueta..." prefWidth="230"/>
    </VBox>
    <VBox spacing="2">
        <Label text="Categoría"/>
        <ComboBox fx:id="cmbCategoria" prefWidth="150"/>
    </VBox>
    <VBox spacing="2">
        <Label text="Tipo"/>
        <ComboBox fx:id="cmbTipo" prefWidth="110"/>
    </VBox>
    <VBox spacing="2">
        <Label text="Estado"/>
        <ComboBox fx:id="cmbEstado" prefWidth="120"/>
    </VBox>
    <VBox spacing="2">
        <Label text="Etiqueta"/>
        <TextField fx:id="txtEtiqueta" promptText="#vacaciones" prefWidth="110"/>
    </VBox>
    <VBox spacing="2">
        <Label text="Desde"/>
        <DatePicker fx:id="dpDesde" prefWidth="125"/>
    </VBox>
    <VBox spacing="2">
        <Label text="Hasta"/>
        <DatePicker fx:id="dpHasta" prefWidth="125"/>
    </VBox>
    <VBox spacing="2">
        <Label text=" "/>
        <Button text="Limpiar filtros" onAction="#onClear"/>
    </VBox>
</FlowPane>
