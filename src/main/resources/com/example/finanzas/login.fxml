<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.finanzas.controller.LoginController">
    <VBox spacing="14" alignment="CENTER">
        <padding>
            <Insets topRightBottomLeft="30"/>
        </padding>
        <Label text="Finanzas Personales" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label text="Inicia sesión para gestionar tus finanzas"/>
        <TextField fx:id="txtUser" promptText="Usuario"/>
        <PasswordField fx:id="txtPass" promptText="Contraseña"/>
        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="btnLogin" text="Iniciar sesión" defaultButton="true" onAction="#onLogin"/>
            <Button fx:id="btnRegister" text="Crear cuenta" onAction="#onRegister"/>
        </HBox>
        <Label fx:id="lblStatus" wrapText="true"/>
    </VBox>
    <fx:include source="components/LoadingOverlay.fxml" fx:id="loadingOverlay"/>
</StackPane>
