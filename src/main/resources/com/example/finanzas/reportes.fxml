<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml" spacing="10" fx:controller="com.example.finanzas.controller.ReportesController">
    <padding>
        <Insets topRightBottomLeft="10"/>
    </padding>
    <Label text="Filtra los movimientos que quieres incluir (categoría, estado, etiqueta, tipo, fechas):"/>
    <fx:include source="components/filtro.fxml" fx:id="filtro"/>
    <Label fx:id="lblSummary"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Formato:"/>
        <ComboBox fx:id="cmbFormato"/>
        <Button fx:id="btnExport" text="Exportar reporte" onAction="#onExport"/>
    </HBox>
    <Label fx:id="lblStatus"/>
</VBox>
